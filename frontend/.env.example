# Frontend environment template for app.algorythmos.com deployment.
# Copy to frontend/.env.local for local development.

# New canonical variable
# Local: http://localhost:8000
# Production: https://api.algorythmos.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Legacy alias supported for backward compatibility during migration
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Google OAuth in UI
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
