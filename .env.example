# Backend environment template for api.algorythmos.com deployment.
# Copy to .env for local development and override values in Vercel.

# Required
ALG_API_KEY=replace-with-secure-api-key
ALG_TENANT_ID=default
ENV=dev

# Canonical API hostname (legacy domains can redirect here)
API_BASE=https://api.algorythmos.com

# CORS (set explicit origins in production)
CORS_ORIGINS=http://localhost:3000,https://app.algorythmos.com

# Auth / platform
GOOGLE_CLIENT_ID=
WEBHOOK_SECRET=replace-with-secure-webhook-secret

# Stateful runtime (required in production)
STATE_BACKEND=memory
REDIS_URL=

# Processing limits
MAX_FILE_MB=25
RUN_MAX_FILE_BYTES=10485760
RUN_MAX_FILES=50

# Observability
LOG_LEVEL=INFO
