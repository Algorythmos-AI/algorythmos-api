# API Configuration
API_KEY=change_me_to_secure_key_min_32_chars
CORS_ORIGINS=https://app.algorythmos.fr
LOG_LEVEL=INFO

# Rate limiting and file size
RATE_PER_MIN=120
MAX_FILE_MB=25

# Optional S3 configuration (unused for now)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

